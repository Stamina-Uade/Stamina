<?xml version="1.0" encoding="utf-8"?>
<!--
  Lo que NO viaja en el backup a la nube ni en la copia a un teléfono nuevo, desde
  Android 12. Hasta Android 11 manda backup_rules.xml, que dice lo mismo.

  🛑 La sesión cifrada no viaja: la llave con la que está cifrada vive en el Keystore
  de ESTE teléfono y no se copia. Ver backup_rules.xml.

  🛑 La carpeta del gimnasio —la rutina y las series guardadas— tampoco, por lo mismo y
  porque son datos de salud de la cuenta que estaba adentro. Ver backup_rules.xml.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="sesion_cifrada.xml" />
        <exclude domain="file" path="gimnasio/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="sesion_cifrada.xml" />
        <exclude domain="file" path="gimnasio/" />
    </device-transfer>
</data-extraction-rules>
