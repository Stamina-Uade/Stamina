# backend/.env.example — la LISTA de lo que hace falta. No es un archivo de secretos.
#
# 🛑 AGENTS.md §12: los secretos salen del gestor de secretos, nunca del repositorio.
# En el servidor, el backend las lee directamente de AWS Secrets Manager al
# arrancar cada proceso (docs/INFRA-EXTERNA.md). Este archivo existe
# para saber QUÉ hace falta, y para levantar el entorno local con docker-compose.
#
# El .env real está en .gitignore y no se commitea nunca.
# En staging: TRAINER_SECRET_ID=stamina/backend/secrets y
# TRAINER_SECRETS_REGION=us-east-1. Si se usan, no definir DATABASE_URL,
# REDIS_URL, JWT_SECRET, SMTP_USER ni SMTP_PASS en el archivo local.
# En staging también es obligatorio STAGING_REGISTRATION_EMAIL: sólo esa casilla
# puede completar un alta mientras la app está en desarrollo.

# --- entorno -----------------------------------------------------------------
# El DEFAULT es production. Un backend que arranca en modo desarrollo porque
# alguien se olvidó de una variable es un backend que filtra errores internos.
# Valores: development | test | staging | production. `staging` es el del servidor
# hoy (decisión 0011): endurecido como producción, pero arranca con los valores
# provisionales. El correo usa SMTP real. Ver config.ts.
NODE_ENV=development
PORT=8082
LOG_LEVEL=info

# --- Postgres ----------------------------------------------------------------
# Base propia y rol propio. NUNCA la base de HonneLink ni la de KARPLAST (§2.3.3).
# El puerto es 5433, NO 5432: docker-compose.yml lo publica ahi a proposito para no
# chocar con otro Postgres local. Apuntar al 5432 es apuntar a la base de OTRO
# proyecto, y Trainer escribiria ahi sin que nadie se entere.
DATABASE_URL=postgres://trainer:trainer@localhost:5433/trainer_db
# Pool chico a propósito: la máquina tiene tres proyectos y max_connections no
# está medido (§2.2). Con el dato se puede subir; sin el dato se arranca chico.
PGPOOL_MAX=5

# --- Redis -------------------------------------------------------------------
# Índice y prefijo propios (§2.3.2). Jamás FLUSHALL, jamás KEYS *.
# 6380 por el mismo motivo que el 5433.
# `REDIS_URL=disabled` corre sin Redis, con la caché en el proceso: es como corre
# en el servidor compartido (decisión 0011). Omitir la variable NO es lo mismo:
# sigue siendo un error de arranque.
REDIS_URL=redis://localhost:6380
REDIS_DB=3
REDIS_PREFIX=trainer:

# --- tokens ------------------------------------------------------------------
# Mínimo 32 bytes. Generar con: openssl rand -base64 48
# En producción sale del gestor de secretos. Rotarlo invalida las sesiones vivas.
JWT_SECRET=cambiar-esto-por-un-secreto-de-al-menos-32-bytes-de-verdad
ACCESS_TTL_S=1800
REFRESH_TTL_S=2592000

# --- correo ------------------------------------------------------------------
# Sin proveedor configurado, los códigos se escriben al log SOLO si NODE_ENV no
# es production. En producción, faltar esto es un error de arranque.
MAIL_PROVIDER=log
MAIL_FROM=no-responder@example.invalid

# --- proxy -------------------------------------------------------------------
# Detrás de Apache hay que confiar en el proxy o todas las requests parecen venir
# de 127.0.0.1 y el rate limit se vuelve un solo bucket global. Pero confiar de
# más es peor: sin proxy adelante, cualquiera manda X-Forwarded-For y se saltea el
# límite. En producción va la IP del vhost, no "true".
# TRUST_PROXY=127.0.0.1
TRUST_PROXY=false
