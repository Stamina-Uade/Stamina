            "value" : "Quel est votre niveau ?"
          }
        }
      }
    },
    "signup.name.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We use your first name to talk to you in notifications and in the weekly summary. Your surname only shows up if you ever share results or join a training group — your profile starts out private."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usamos tu nombre para hablarte en las notificaciones y en el resumen de cada semana. El apellido solo aparece si algún día compartís tus resultados o te sumás a un grupo de entrenamiento; tu perfil arranca privado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On utilise ton prénom pour s'adresser à toi dans les notifications et le résumé hebdo. Ton nom n'apparaît que si tu partages un jour des résultats ou rejoins un groupe d'entraînement — ton profil est privé au départ."
          }
        }
      }
    },
