    "signup.before.accept_health" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I understand that Stamina doesn't replace a professional and that, if something happens to me while I train, I have to stop and get checked."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entiendo que Stamina no reemplaza a un profesional y que, si algo me pasa mientras entreno, tengo que parar y consultar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je comprends que Stamina ne remplace pas un professionnel et que, s'il m'arrive quelque chose pendant l'entraînement, je dois m'arrêter et consulter."
          }
        }
      }
    },
