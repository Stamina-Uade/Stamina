    "Este día ya pasó. No pasa nada: el plan sigue con lo que viene." : {
      "comment" : "Plan, día pasado sin hacer",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This day has passed. No problem: the plan moves on to what's next."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este día ya pasó. No pasa nada: el plan sigue con lo que viene."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce jour est passé. Pas de souci : le plan continue avec la suite."
          }
        }
      }
    },
    "Estima tu pulso máximo y, con él, tus zonas de pulso." : {
      "comment" : "Para qué se usa la edad",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estimates your max heart rate and, from it, your heart rate zones."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estima tu pulso máximo y, con él, tus zonas de pulso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estime ta fréquence cardiaque maximale et, à partir d'elle, tes zones cardiaques."
          }
        }
      }
    },
