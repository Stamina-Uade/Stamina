    },
    "signup.sex.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sweat rates, sodium loss and calorie burn differ quite a bit between men and women at the same weight and pace. We only use it to work out your plan: it isn't shown on your profile and it isn't shared. If you'd rather not answer, you can choose \"I'd rather not say\"."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las tasas de sudoración, la pérdida de sodio y el gasto calórico difieren bastante entre hombres y mujeres con el mismo peso y ritmo. Solo lo usamos para el cálculo del plan: no se muestra en tu perfil ni se comparte. Si preferís no responder, podés elegir «Prefiero no decirlo»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le taux de sudation, la perte de sodium et la dépense calorique varient pas mal entre hommes et femmes à poids et allure égaux. On ne l'utilise que pour calculer ton plan : ce n'est pas affiché sur ton profil ni partagé. Si tu préfères ne pas répondre, tu peux choisir « Je préfère ne pas le dire »."
          }
        }
      }
    },
