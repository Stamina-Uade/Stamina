    "«Hoy» es la sesión que te toca. Tocá la zona o la hidratación y te explicamos qué significan." : {
      "comment" : "Guía del inicio: hoy",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Today” is the session you have to do. Tap the zone or hydration and we'll explain what they mean."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Hoy» es la sesión que te toca. Tocá la zona o la hidratación y te explicamos qué significan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Aujourd'hui », c'est ta séance du jour. Touche la zone ou l'hydratation et on t'explique ce qu'elles veulent dire."
          }
        }
      }
    },
