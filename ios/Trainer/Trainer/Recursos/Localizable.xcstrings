    "password.reset.email.anti_enumeration" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For security, the message is sent whether or not the address has an account."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por seguridad, el mensaje se envía aunque el correo no esté registrado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Par sécurité, le message est envoyé que l'adresse ait un compte ou non."
