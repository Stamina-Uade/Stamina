    "signup.level.beginner.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Less than a year training, or coming back after a break"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menos de un año entrenando o volviendo después de un parate"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moins d'un an d'entraînement, ou reprise après une pause"
          }
        }
      }
    },
    "signup.level.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This sets the volume your plan starts at and how much it can grow each week without exposing you to injury. If you're coming back after a long break, pick beginner — the load can always go up later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Define desde qué volumen arranca tu plan y cuánto puede crecer por semana sin exponerte a lesiones. Si volvés después de un parate largo, elegí principiante: siempre se puede subir la carga más adelante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ça définit le volume de départ de ton plan et de combien il peut augmenter chaque semaine sans t'exposer aux blessures. Si tu reprends après une longue pause, choisis débutant — la charge pourra toujours augmenter ensuite."
          }
        }
      }
    },
    "signup.level.intermediate" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intermediate"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intermedio"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intermédiaire"
