    "signup.days.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This isn't a profile field: it's what triggers your alerts. We message you 45 minutes before each session so you can get bottles, gels and your snack ready, and we use your times to put the long sessions on the days you have most room."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto no es un dato de perfil: es lo que dispara los avisos. Te escribimos 45 minutos antes de cada sesión para que prepares bidones, geles y el snack previo, y usamos tus horarios para repartir las sesiones largas en los días con más tiempo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce n'est pas un champ de profil : c'est ce qui déclenche tes alertes. On t'envoie un message 45 minutes avant chaque séance pour que tu prépares tes bidons, tes gels et ta collation, et on utilise tes horaires pour placer les séances longues les jours où tu as le plus de temps."
          }
        }
      }
    },
