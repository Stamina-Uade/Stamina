    "clave.codigo.texto" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We sent a 6-character code, with numbers and letters, to %@. It can take up to a minute; if it doesn't turn up, check your spam folder. The code expires in 15 minutes and works only once."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviamos un código de 6 caracteres, con números y letras, a %@. Puede tardar hasta un minuto; si no aparece, revisá spam o correo no deseado. El código vence a los 15 minutos y solo sirve una vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We sent a 6-character code, with numbers and letters, to %@. It can take up to a minute; if it doesn't turn up, check your spam folder. The code expires in 15 minutes and works only once."
          }
        }
      }
    },
