      }
    },
    "password.reset.email.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter the email you signed up with and we'll send you a code to choose a new password. Your training plan, your days and your history stay untouched — only the way you sign in changes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribí el correo con el que creaste tu cuenta y te enviamos un código para elegir una contraseña nueva. Tu plan de entrenamiento, tus días y tu historial quedan intactos: solo cambia la forma de entrar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisis l'e-mail utilisé à l'inscription et on t'enverra un code pour choisir un nouveau mot de passe. Ton plan d'entraînement, tes jours et ton historique restent intacts — seule ta façon de te connecter change."
          }
        }
      }
    },
