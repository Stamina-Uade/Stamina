      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your previous plan is over or you don't have a goal yet. Tell us what you want to run and when, and we'll build weeks tailored to you."
          }
        },
