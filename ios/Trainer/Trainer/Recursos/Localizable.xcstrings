    "password.reset.done.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can sign in with your new password now. We signed you out everywhere else — if you didn't ask for this change, write to us from this same address."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya podés entrar con tu contraseña nueva. Cerramos la sesión en los otros dispositivos: si no fuiste vos quien pidió el cambio, escribinos desde este mismo correo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu peux te connecter avec ton nouveau mot de passe dès maintenant. On t'a déconnecté partout ailleurs — si tu n'as pas demandé ce changement, écris-nous depuis cette même adresse."
          }
        }
      }
    },
    "password.reset.done.changed" : {
