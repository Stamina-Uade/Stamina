    "nutricion.sin_objetivos.embarazo_o_lactancia" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We don't calculate targets during pregnancy or breastfeeding. It's best to follow this with your healthcare team."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante el embarazo o la lactancia no calculamos objetivos: lo mejor es seguirlo con tu equipo de salud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We don't calculate targets during pregnancy or breastfeeding. It's best to follow this with your healthcare team."
          }
        }
      }
    },
    "nutricion.sin_objetivos.falta_embarazo_o_lactancia" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We don't know yet whether you're pregnant or breastfeeding, and that changes the numbers. Until we do, we don't calculate them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todavía no sabemos si estás embarazada o en lactancia, y eso cambia los números. Hasta saberlo, no los calculamos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We don't know yet whether you're pregnant or breastfeeding, and that changes the numbers. Until we do, we don't calculate them."
          }
        }
      }
    },
    "nutricion.sin_objetivos.menor_de_edad" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We don't calculate calorie targets before 18. At that age it's best to have a professional guide you."
