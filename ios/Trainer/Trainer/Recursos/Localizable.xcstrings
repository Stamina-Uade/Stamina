    "signup.health.accept" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I understand that Stamina gives general suggestions and that if any symptom appears I have to stop and seek advice."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entiendo que Stamina da sugerencias generales y que ante cualquier síntoma tengo que parar y consultar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je comprends que Stamina donne des conseils généraux et que si un symptôme apparaît, je dois m'arrêter et consulter."
          }
        }
      }
    },
    "signup.health.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We're not doctors and this app is not a substitute for seeing one. If you have a pre-existing condition, take medication, or haven't trained in years, talk to a professional before starting the plan."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No somos médicos y esta app no reemplaza una consulta. Si tenés alguna condición previa, tomás medicación o hace años que no entrenás, hablá con un profesional antes de empezar el plan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous ne sommes pas médecins et cette appli ne remplace pas une consultation. Si tu as une pathologie existante, prends un traitement ou ne t'es pas entraîné depuis des années, parles-en à un professionnel avant de commencer le plan."
          }
        }
      }
    },
