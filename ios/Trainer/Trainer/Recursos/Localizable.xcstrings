    "plan.phase.generic.body" : {
      "comment" : "Plan, fase sin explicación específica",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A phase with its own goal. Each week's days already account for it: just follow them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una etapa con un objetivo propio. Los días de cada semana ya la tienen en cuenta: seguilos y listo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
