    "plan.phase.peak.body" : {
      "comment" : "Plan, para qué sirve la fase pico",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The toughest weeks: the longest long run and the workouts closest to race day."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las semanas más exigentes: el fondo más largo y los entrenamientos más parecidos a la carrera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les semaines les plus exigeantes : la sortie longue la plus longue et les entraînements les plus proches de la course."
          }
        }
      }
    },
    "plan.phase.peak.tip" : {
      "comment" : "Plan, consejo fase pico",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep and eat well: feeling tired is expected here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duerme y come bien: acá el cansancio es esperable."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dors et mange bien : ici, la fatigue est normale."
          }
        }
      }
    },
    "plan.phase.race" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Race"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carrera"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Course"
          }
        }
      }
    },
    "plan.phase.race.body" : {
      "comment" : "Plan, para qué sirve la fase de carrera",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Race week: short and easy, so you arrive with fresh legs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La semana de la carrera: poco y suave, para llegar con las piernas frescas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La semaine de la course : peu et facile, pour arriver avec les jambes fraîches."
          }
        }
      }
    },
    "plan.phase.race.tip" : {
      "comment" : "Plan, consejo fase de carrera",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Don't try anything new on race day: no new shoes, no new gels."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No estrenes nada el día de la carrera: ni zapatillas ni geles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne teste rien de nouveau le jour de la course : ni chaussures ni gels."
          }
        }
      }
    },
    "plan.phase.taper" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taper"
