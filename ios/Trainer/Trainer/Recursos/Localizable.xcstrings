    },
    "signup.sport.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each discipline burns fluid and carbohydrate differently: on a bike you can drink more and eat solid food; running, it's better to spread it out. Pick the one you train most — you can add the others later from your profile."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada disciplina consume líquido y carbohidrato de forma distinta: en bici puedes tomar más y comer sólido, corriendo conviene fraccionar. Elige el que más entrenas; después puedes sumar los otros desde tu perfil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque discipline consomme liquides et glucides différemment : à vélo, tu peux boire davantage et manger solide ; en course à pied, mieux vaut répartir les apports. Choisis celle que tu pratiques le plus — tu pourras ajouter les autres plus tard depuis ton profil."
          }
        }
      }
    },
