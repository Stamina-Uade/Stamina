          }
        }
      }
    },
    "plan.phase.base.body" : {
      "comment" : "Plan, para qué sirve la fase base",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It's the foundation: lots of easy running so your heart, legs and tendons get used to running often without getting injured."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es el cimiento: mucho trote suave para que el corazón, las piernas y los tendones se acostumbren a correr seguido sin lesionarse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C'est la fondation : beaucoup de footing facile pour que ton cœur, tes jambes et tes tendons s'habituent à courir souvent sans se blesser."
          }
        }
      }
    },
    "plan.phase.base.tip" : {
      "comment" : "Plan, consejo fase base",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you feel slow, that's fine: it's on purpose."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si sentís que vas lento, está bien: es a propósito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si tu as l'impression d'aller lentement, c'est normal : c'est voulu."
          }
        }
      }
    },
    "plan.phase.build" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
