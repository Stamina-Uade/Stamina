    "signup.tracking.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you connect your watch or your phone's GPS, we tune hydration and gels to your real pace and heart rate instead of estimates. You can skip this and connect it later from Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si conectás tu reloj o el GPS del teléfono, ajustamos hidratación y geles con el ritmo y la frecuencia cardíaca reales, no con estimaciones. Podés saltear este paso y conectarlo más adelante desde Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si tu connectes ta montre ou le GPS de ton téléphone, on ajuste l'hydratation et les gels à ton allure et ta fréquence cardiaque réelles plutôt qu'à des estimations. Tu peux passer cette étape et connecter plus tard depuis les Réglages."
          }
        }
      }
    },
