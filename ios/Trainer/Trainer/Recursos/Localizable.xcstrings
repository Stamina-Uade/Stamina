    "signup.goal.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With the date of your event we build the countdown and lay out the loading, recovery and taper weeks. If you haven't picked a race yet, carry on without a date: we'll build a base plan and adjust it once you set one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con la fecha del evento armamos la cuenta regresiva y repartimos las semanas de carga, descarga y afinamiento. Si todavía no tenés carrera elegida, seguí sin fecha: armamos un plan de base y lo ajustamos cuando la definas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec la date de ton épreuve, on crée le compte à rebours et on répartit les semaines de charge, de récupération et d'affûtage. Si tu n'as pas encore choisi de course, continue sans date : on créera un plan de base et on l'ajustera dès que tu en fixeras une."
          }
        }
      }
    },
    "signup.goal.c10k" : {
