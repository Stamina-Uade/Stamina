          }
        }
      }
    },
    "signup.level.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How long have you been training?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Hace cuánto entrenás?"
          }
        },
        "fr" : {
          "stringUnit" : {
