    "reg.medicion.no_se_guarda" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This answer isn't saved yet: the contract has nowhere to put it. It's logged as B-006 and blocks nothing — continue and connect it later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta respuesta todavía no se guarda: el contrato no tiene dónde. Está anotado como B-006 y no bloquea nada: podés seguir y conectarlo más adelante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This answer isn't saved yet: the contract has nowhere to put it. It's logged as B-006 and blocks nothing — continue and connect it later."
          }
        }
      }
    },
    "reg.medicion.texto" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you connect your watch or your phone's GPS, we tune hydration and gels to your real pace and heart rate instead of estimates. You can skip this and connect it later from Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si conectás tu reloj o el GPS del teléfono, ajustamos hidratación y geles con el ritmo y la frecuencia cardíaca reales, no con estimaciones. Podés saltear este paso y conectarlo más adelante desde Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you connect your watch or your phone's GPS, we tune hydration and gels to your real pace and heart rate instead of estimates. You can skip this and connect it later from Settings."
          }
        }
      }
    },
