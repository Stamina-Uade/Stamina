      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At least 10 characters, with one capital letter and one number. When you save it we'll sign you out on every other device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al menos 10 caracteres, con una mayúscula y un número. Cuando la guardes vamos a cerrar la sesión en los otros dispositivos donde hayas entrado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Au moins 10 caractères, dont une majuscule et un chiffre. Quand tu l'enregistreras, on te déconnectera de tous tes autres appareils."
          }
        }
      }
    },
