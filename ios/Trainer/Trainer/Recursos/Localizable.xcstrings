    },
    "El borde de color marca hoy; el borde grueso, el día que elegiste." : {
      "comment" : "Calendario de hitos: qué significan los bordes",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The colored border marks today; the thick border, the day you picked."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El borde de color marca hoy; el borde grueso, el día que elegiste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La bordure colorée indique aujourd'hui ; la bordure épaisse, le jour choisi."
          }
        }
      }
    },
    "El certificado que te dio tu médico" : {
