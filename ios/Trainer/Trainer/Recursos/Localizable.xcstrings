    "reg.salud.texto" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We're not doctors and this app is not a substitute for seeing one. If you have a pre-existing condition, take medication, or haven't trained in years, talk to a professional before starting the plan."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No somos médicos y esta app no reemplaza una consulta. Si tenés alguna condición previa, tomás medicación o hace años que no entrenás, hablá con un profesional antes de empezar el plan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We're not doctors and this app is not a substitute for seeing one. If you have a pre-existing condition, take medication, or haven't trained in years, talk to a professional before starting the plan."
