    "account.pending_deletion.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "You asked to delete it, and in %lld day it'll be gone for good. If you recover it, you lose nothing."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "You asked to delete it, and in %lld days it'll be gone for good. If you recover it, you lose nothing."
                }
              }
            }
          }
        },
        "es" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Pediste borrarla y en %lld día se borra del todo. Si la recuperas, no pierdes nada."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Pediste borrarla y en %lld días se borra del todo. Si la recuperas, no pierdes nada."
                }
              }
            }
          }
        },
        "fr" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Tu as demandé sa suppression : dans %lld jour, il sera supprimé pour de bon. Si tu le récupères, tu ne perds rien."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Tu as demandé sa suppression : dans %lld jours, il sera supprimé pour de bon. Si tu le récupères, tu ne perds rien."
                }
              }
            }
          }
        }
      }
    },
