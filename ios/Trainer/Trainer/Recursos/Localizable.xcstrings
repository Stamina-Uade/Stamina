            "state" : "translated",
            "value" : "Terminée"
          }
        }
      }
    },
    "plan.phase.generic.body" : {
      "comment" : "Plan, fase sin explicación específica",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A phase with its own goal. Each week's days already account for it: just follow them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una etapa con un objetivo propio. Los días de cada semana ya la tienen en cuenta: síguelos y listo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une étape avec son propre objectif. Les jours de chaque semaine en tiennent déjà compte : suis-les, c'est tout."
          }
        }
      }
    },
    "plan.phase.hint" : {
