      }
    },
    "Lo cargaste al registrarte. Por ahora no se puede cambiar desde la app." : {
      "comment" : "Dato del cuerpo ya cargado, sin edición",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You added it when you signed up. For now it can't be changed in the app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
