    "Exigente pero sostenible. Te salen frases cortas. Afina tu ritmo de carrera." : {
      "comment" : "Explicación de la zona 3",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hard but sustainable. Only short sentences come out. Sharpens your race pace."
