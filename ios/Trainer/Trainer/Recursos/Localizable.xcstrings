    "signup.body.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weight is the basis of the whole calculation: litres of fluid per hour, milligrams of sodium and grams of carbohydrate are all estimated per kilo. Height lets us adjust your resting energy expenditure. You can update both any time from your profile."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El peso es la base del cálculo: litros de líquido por hora, miligramos de sodio y gramos de carbohidrato que tenés que reponer se estiman por kilo. Con la altura ajustamos el gasto energético en reposo. Podés actualizar ambos cuando quieras desde tu perfil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le poids est la base de tout le calcul : les litres de liquide par heure, les milligrammes de sodium et les grammes de glucides sont tous estimés par kilo. La taille nous permet d'ajuster ta dépense énergétique au repos. Tu peux modifier les deux à tout moment depuis ton profil."
          }
        }
      }
    },
