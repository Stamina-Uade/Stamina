    "signup.code.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We sent a 6-character code, with numbers and letters, to %@. It can take up to a minute; if it doesn't turn up, check your spam folder. The code expires in 15 minutes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviamos un código de 6 caracteres, con números y letras, a %@. Puede tardar hasta un minuto en llegar; si no aparece, revisá spam o correo no deseado. El código vence a los 15 minutos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On a envoyé un code de 6 caractères, chiffres et lettres, à %@. Ça peut prendre jusqu'à une minute ; s'il n'arrive pas, vérifie tes spams. Le code expire dans 15 minutes."
          }
        }
      }
    },
