    "reg.correo.ok" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Looks good. We'll send you a 6-character code."
          }
        },
        "es" : {
