    "plan.phase.peak.body" : {
      "comment" : "Plan, para qué sirve la fase pico",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The toughest weeks: the longest long run and the workouts closest to race day."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las semanas más exigentes: el fondo más largo y los entrenamientos más parecidos a la carrera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les semaines les plus exigeantes : la sortie longue la plus longue et les entraînements les plus proches de la course."
          }
        }
      }
    },
    "plan.phase.peak.tip" : {
      "comment" : "Plan, consejo fase pico",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep and eat well: feeling tired is expected here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dormí y comé bien: acá el cansancio es esperable."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dors et mange bien : ici, la fatigue est normale."
          }
        }
      }
    },
