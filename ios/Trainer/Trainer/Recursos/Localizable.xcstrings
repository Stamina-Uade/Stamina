      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At least %lld characters, with one capital letter and one number. It's the only password we'll ask you for: it gets you in from any phone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
