          }
        }
      }
    },
    "El desafío supremo de resistencia aeróbica, fuerza mental y fondo." : {
      "comment" : "Selector de metas: descripción de la meta",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The ultimate challenge of aerobic endurance, mental strength and stamina."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El desafío supremo de resistencia aeróbica, fuerza mental y fondo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le défi ultime d'endurance aérobie, de force mentale et de fond."
          }
        }
      }
    },
    "El entrenamiento no registró desplazamiento suficiente o duró menos de 10 segundos. ¿Deseas descartarlo o reanudarlo?" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The workout did not record enough movement or lasted less than 10 seconds. Do you want to discard or resume it?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El entrenamiento no registró desplazamiento suficiente o duró menos de 10 segundos. ¿Deseas descartarlo o reanudarlo?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'entraînement n'a pas enregistré de déplacement suffisant ou a duré moins de 10 secondes. Souhaitez-vous le supprimer ou le reprendre ?"
          }
        }
      }
    },
