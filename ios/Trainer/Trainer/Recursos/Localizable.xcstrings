    "signup.password.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At least %lld characters, with one capital letter and one number. It's the only password we'll ask you for: it gets you in from any phone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al menos %lld caracteres, con una mayúscula y un número. Es la única contraseña que te vamos a pedir: con ella entrás desde cualquier teléfono."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Au moins %lld caractères, dont une majuscule et un chiffre. C'est le seul mot de passe qu'on te demandera : il te permet de te connecter depuis n'importe quel téléphone."
          }
        }
      }
    },
    "signup.password.gap_note" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This screen is NOT in the design: the 13 steps never ask for a password and the contract requires one. It's a gap in the design, noted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta pantalla NO está en el diseño: los 13 pasos nunca piden contraseña y el contrato la exige. Es un hueco del diseño, anotado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet écran n'est PAS dans la maquette : les 13 étapes ne demandent jamais de mot de passe et le contrat en exige un. C'est un manque dans la maquette, noté."
          }
        }
      }
    },
    "signup.password.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
