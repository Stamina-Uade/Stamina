    "reg.nacimiento.texto" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your age sets your heart-rate zones, your estimated sweat rate and how many calories you need in high-load weeks. It also lets us compare you against performance tables for your age group."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La edad define tus zonas de frecuencia cardíaca, el ritmo de sudoración estimado y cuántas calorías necesitás en semanas de carga alta. También nos deja compararte con tablas de rendimiento de tu categoría."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your age sets your heart-rate zones, your estimated sweat rate and how many calories you need in high-load weeks. It also lets us compare you against performance tables for your age group."
          }
        }
      }
    },
