            "value" : "What to bring to drink and eat"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qué llevar para tomar"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quoi emporter à boire et à manger"
          }
        }
      }
    },
    "plan.day.why_today" : {
      "comment" : "Plan, motivos de la sesión",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Why today"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por qué hoy"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pourquoi aujourd'hui"
          }
        }
      }
    },
    "plan.day.zone1" : {
      "comment" : "Explicación de la zona 1",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Very easy: you can chat effortlessly. Good for recovering."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muy suave: puedes charlar sin esfuerzo. Sirve para recuperarte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Très facile : tu peux bavarder sans effort. Idéal pour récupérer."
          }
        }
      }
    },
    "plan.day.zone2" : {
      "comment" : "Explicación de la zona 2",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Easy and comfortable: you can speak in full sentences. Builds endurance without overtiring you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suave y cómodo: puedes hablar en frases completas. Construye resistencia sin cansarte de más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facile et confortable : tu peux parler en phrases complètes. Développe l'endurance sans te fatiguer inutilement."
          }
        }
      }
    },
    "plan.day.zone3" : {
      "comment" : "Explicación de la zona 3",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moderate: you speak in short sentences. Improves the pace you can hold for a long time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moderado: hablas con frases cortas. Mejora el ritmo que puedes sostener mucho rato."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modéré : tu parles en phrases courtes. Améliore l'allure que tu peux tenir longtemps."
          }
        }
      }
    },
    "plan.day.zone4" : {
      "comment" : "Explicación de la zona 4",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hard: only a few words come out. Raises the pace you can hold before tiring."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fuerte: te salen pocas palabras. Sube el ritmo que aguantas antes de cansarte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Difficile : seuls quelques mots sortent. Élève l'allure que tu tiens avant de te fatiguer."
          }
        }
      }
    },
    "plan.day.zone5" : {
      "comment" : "Explicación de la zona 5",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All out: you can't talk. Short efforts to build speed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al máximo: no puedes hablar. Son esfuerzos cortos para ganar velocidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À fond : impossible de parler. Des efforts courts pour gagner en vitesse."
          }
        }
      }
    },
