    "reg.correo.texto" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We check it before asking for anything else, so you don't fill in the whole form only to find a typo at the end. It's also the address you'll use to get your plan back if you change phones, and where we send your weekly training-load summary."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo validamos antes de pedirte cualquier otro dato, así no completás todo el registro para descubrir al final que había un error de tipeo. Es también la dirección con la que vas a recuperar tu plan si cambiás de teléfono, y la que usamos para el resumen semanal de tu carga de entrenamiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We check it before asking for anything else, so you don't fill in the whole form only to find a typo at the end. It's also the address you'll use to get your plan back if you change phones, and where we send your weekly training-load summary."
          }
        }
      }
    },
