    "Hoy toca descansar. El cuerpo se hace más fuerte mientras se recupera: caminar o elongar suave está bien." : {
      "comment" : "Plan, explicación de un día de descanso",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Today is a rest day. Your body gets stronger while it recovers: an easy walk or gentle stretching is fine."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoy toca descansar. El cuerpo se hace más fuerte mientras se recupera: caminar o elongar suave está bien."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aujourd'hui, c'est repos. Le corps se renforce pendant qu'il récupère : marcher ou s'étirer en douceur, c'est très bien."
          }
        }
      }
    },
