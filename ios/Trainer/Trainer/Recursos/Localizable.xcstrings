    "reg.deporte.texto" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each discipline burns fluid and carbohydrate differently: on a bike you can drink more and eat solid food; running, it's better to spread it out. Pick the one you train most — you can add the others later from your profile."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada disciplina consume líquido y carbohidrato de forma distinta: en bici podés tomar más y comer sólido, corriendo conviene fraccionar. Elegí el que más entrenás; después podés sumar los otros desde tu perfil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each discipline burns fluid and carbohydrate differently: on a bike you can drink more and eat solid food; running, it's better to spread it out. Pick the one you train most — you can add the others later from your profile."
          }
        }
      }
    },
