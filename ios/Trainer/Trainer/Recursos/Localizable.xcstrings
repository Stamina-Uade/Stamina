    "plan.phase.race.body" : {
      "comment" : "Plan, para qué sirve la fase de carrera",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Race week: short and easy, so you arrive with fresh legs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La semana de la carrera: poco y suave, para llegar con las piernas frescas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La semaine de la course : peu et facile, pour arriver avec les jambes fraîches."
          }
        }
      }
    },
    "plan.phase.race.tip" : {
      "comment" : "Plan, consejo fase de carrera",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Don't try anything new on race day: no new shoes, no new gels."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No estrenes nada el día de la carrera: ni zapatillas ni geles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne teste rien de nouveau le jour de la course : ni chaussures ni gels."
          }
        }
      }
    },
