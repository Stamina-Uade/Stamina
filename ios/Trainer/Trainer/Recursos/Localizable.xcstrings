    "plan.phase.taper.body" : {
      "comment" : "Plan, para qué sirve la fase de afinamiento",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volume drops so you arrive rested without losing your edge: fewer kilometers and a bit of pace."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baja el volumen para que llegues descansado sin perder la chispa: menos kilómetros y algo de ritmo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le volume baisse pour que tu arrives reposé sans perdre ton peps : moins de kilomètres et un peu d'allure."
          }
        }
      }
    },
    "plan.phase.taper.tip" : {
      "comment" : "Plan, consejo fase de afinamiento",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you have energy to spare, that's the idea. Don't add extra kilometers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si te sobra energía, es la idea. No agregues kilómetros de más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si tu as de l'énergie à revendre, c'est le but. N'ajoute pas de kilomètres en plus."
          }
        }
      }
    },
