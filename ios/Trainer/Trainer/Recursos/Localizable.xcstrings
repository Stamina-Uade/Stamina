    "plan.phase.base" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Base"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Base"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Base d'endurance"
          }
        }
      }
    },
    "plan.phase.base.body" : {
      "comment" : "Plan, para qué sirve la fase base",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It's the foundation: lots of easy running so your heart, legs and tendons get used to running often without getting injured."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es el cimiento: mucho trote suave para que el corazón, las piernas y los tendones se acostumbren a correr seguido sin lesionarse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C'est la fondation : beaucoup de footing facile pour que ton cœur, tes jambes et tes tendons s'habituent à courir souvent sans se blesser."
          }
        }
      }
    },
    "plan.phase.base.tip" : {
      "comment" : "Plan, consejo fase base",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you feel slow, that's fine: it's on purpose."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si sientes que vas lento, está bien: es a propósito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si tu as l'impression d'aller lentement, c'est normal : c'est voulu."
          }
        }
      }
    },
    "plan.phase.build" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Build"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Construcción"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Développement"
          }
        }
      }
    },
    "plan.phase.build.body" : {
      "comment" : "Plan, para qué sirve la fase de construcción",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Load builds up gradually: more kilometers and some pace sessions to gain endurance and speed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se suma carga de a poco: más kilómetros y algunas sesiones a ritmo para ganar resistencia y velocidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La charge augmente peu à peu : plus de kilomètres et quelques séances à allure pour gagner en endurance et en vitesse."
          }
        }
      }
    },
    "plan.phase.build.tip" : {
      "comment" : "Plan, consejo fase de construcción",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some weeks are harder; the lighter ones are there so your body can absorb it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunas semanas cuestan más; las más livianas están para que el cuerpo lo absorba."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certaines semaines sont plus dures ; les plus légères sont là pour que ton corps assimile."
          }
        }
      }
    },
    "plan.phase.completed" : {
      "comment" : "Plan, fase hecha",
