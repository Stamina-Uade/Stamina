    "reg.objetivo.sin_fecha" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No date yet: we'll build you a base plan."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todavía sin fecha: vamos a armar un plan de base."
          }
