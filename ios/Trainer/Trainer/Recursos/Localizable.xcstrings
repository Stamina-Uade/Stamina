    "home.explainer.zone1" : {
      "comment" : "Explicación de la zona 1",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Very easy. You could chat nonstop. Good for recovery."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muy suave. Podrías charlar sin parar. Sirve para recuperar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Très facile. Tu pourrais bavarder sans t'arrêter. Idéal pour récupérer."
          }
        }
      }
    },
    "home.explainer.zone2" : {
      "comment" : "Explicación de la zona 2",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comfortable. You can speak in full sentences. It builds your base and it's the one you'll use most."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cómoda. Hablas en frases completas. Es la que arma tu base y la que más vas a usar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confortable. Tu parles en phrases complètes. C'est elle qui construit ta base et que tu utiliseras le plus."
          }
        }
      }
    },
    "home.explainer.zone3" : {
      "comment" : "Explicación de la zona 3",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hard but sustainable. Only short sentences come out. Sharpens your race pace."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exigente pero sostenible. Te salen frases cortas. Afina tu ritmo de carrera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exigeante mais tenable. Tu ne fais que des phrases courtes. Elle affine ton allure de course."
          }
        }
      }
    },
    "home.explainer.zone4" : {
      "comment" : "Explicación de la zona 4",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hard. Just a few words at a time. Done in intervals, to raise your threshold."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dura. Solo palabras sueltas. Va en tramos, para subir tu umbral."
