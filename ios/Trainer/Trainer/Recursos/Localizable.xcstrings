    "signup.days.alert" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You'll get %lld alerts a week, 45 min before each session."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vas a recibir %lld avisos por semana, 45 min antes de cada sesión."
