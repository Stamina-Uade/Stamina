          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton plan précédent est terminé ou tu n'as pas encore d'objectif. Dis-nous ce que tu veux courir et quand, et on prépare des semaines sur mesure."
          }
        }
      }
    },
