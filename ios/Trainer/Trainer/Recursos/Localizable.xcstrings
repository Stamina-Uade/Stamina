    "medical.disclaimer" : {
      "comment" : "Nota legal del apto",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stamina doesn't replace seeing a doctor. Your clearance is stored only on this phone, protected, and is never shared with anyone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stamina no reemplaza la consulta médica. Tu apto se guarda solo en este teléfono, protegido, y no se comparte con nadie."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stamina ne remplace pas une consultation médicale. Ton certificat est enregistré uniquement sur ce téléphone, protégé, et n'est partagé avec personne."
          }
        }
      }
    },
