    "reg.clave.hueco" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This screen is NOT in the design: the 13 steps never ask for a password and the contract requires one. It's a gap in the design, noted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta pantalla NO está en el diseño: los 13 pasos nunca piden contraseña y el contrato la exige. Es un hueco del diseño, anotado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
