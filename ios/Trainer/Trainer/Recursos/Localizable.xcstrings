    },
    "reg.clave.texto" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At least %lld characters, with one capital letter and one number. It's the only password we'll ask you for: it gets you in from any phone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al menos %lld caracteres, con una mayúscula y un número. Es la única contraseña que te vamos a pedir: con ella entrás desde cualquier teléfono."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At least %lld characters, with one capital letter and one number. It's the only password we'll ask you for: it gets you in from any phone."
          }
        }
      }
    },
