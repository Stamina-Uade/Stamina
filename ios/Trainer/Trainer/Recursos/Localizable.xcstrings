    "account.deactivated.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your data is still saved. If you reactivate it, everything will be just as you left it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus datos siguen guardados. Si la reactivas, todo vuelve a estar como lo dejaste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tes données sont toujours enregistrées. Si tu le réactives, tout redevient comme tu l'as laissé."
          }
        }
      }
    },
    "account.deactivated.done" : {
      "extractionState" : "manual",
      "localizations" : {
